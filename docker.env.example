# API-ключи Zernio задаются отдельно внутри каждого профиля в интерфейсе FERMA.
# Общий ZERNIO_API_KEY больше не используется.

# Trial reels: off | on | comma-separated profile names (first check on one profile)
REELS=off
# Encoder threads per reel render
REELS_THREADS=2

# FERMA со своих устройств через домен (как Gudini): пароль входа, не короче 8 знаков.
# Без него порт 3104 не открывается, FERMA работает только на этом компьютере.
FERMA_SITE_PASSWORD=
# Куда Meta возвращает после входа: домен FERMA с паролем (или http://localhost:3100, только этот компьютер).
FERMA_OWNER_URL=https://ваш-домен-ferma
